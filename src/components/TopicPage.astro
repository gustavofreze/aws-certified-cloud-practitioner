---
/**
 * One topic of the roadmap in one language.
 *
 * Every topic page has the same structure. The cover is a deep band, the same ground as the home, naming
 * the topic and where it sits on the roadmap. A bar of pills stays on top while the reader scrolls and
 * marks the section being read, because a reader comes back to these pages holding one subject in mind.
 * Each section is a card with the same anatomy (see `SectionCard.astro`).
 */
import { renderInline } from '../content/inline'
import { topicAt, topicsOf } from '../content'
import { pageHref, pagePaths } from '../i18n'
import { getCopy, type Locale, MAIN_ID } from '../i18n/strings'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from './Icon.astro'
import SectionCard from './SectionCard.astro'

interface Props {
  locale: Locale
  slug: string
}
const { locale, slug } = Astro.props
const copy = getCopy(locale)
const { topic, previous, next } = topicAt(locale, slug)
const total = topicsOf(locale).length
const index = topicsOf(locale).indexOf(topic) + 1
const absolute = (path: string): string => new URL(path, Astro.site).href
const breadcrumb = [
  { name: copy.nav.home, item: absolute(pageHref(locale)) },
  { name: topic.title, item: absolute(pageHref(locale, topic.slug)) },
].map((crumb, position) => ({ '@type': 'ListItem', position: position + 1, ...crumb }))
---

<BaseLayout
  locale={locale}
  title={topic.title}
  description={topic.summary}
  paths={pagePaths(topic.slug)}
  structuredData={{ '@type': 'BreadcrumbList', itemListElement: breadcrumb }}
>
  <span class="cert-progress" aria-hidden="true"><span data-read></span></span>

  <main id={MAIN_ID} class="cert-page" data-pagefind-body>
    <div class="cert-cover">
      <span class="cert-hero__glow cert-hero__glow--orange" aria-hidden="true"></span>
      <span class="cert-cover__mark" aria-hidden="true"><Icon name={topic.icon} size={220} /></span>
      <div class="cert-wrap cert-cover__inner">
        <nav aria-label={copy.nav.breadcrumb} class="cert-crumbs enter-rise" data-pagefind-ignore>
          <a href={pageHref(locale)}>{copy.nav.home}</a>
          <span class="cert-crumbs__sep" aria-hidden="true">/</span>
          <a href={`${pageHref(locale)}#roadmap`}>{copy.home.groups[topic.group].title}</a>
          <span class="cert-crumbs__sep" aria-hidden="true">/</span>
          <span>{copy.topic.step(index, total)}</span>
        </nav>
        <div class="cert-cover__head enter-rise" style="--enter-delay:60ms">
          <span class="cert-tile cert-tile--large cert-tile--deep">
            <Icon name={topic.icon} size={28} />
          </span>
          <h1 class="cert-cover__title">{topic.title}</h1>
        </div>
        <p class="cert-cover__lede enter-rise" style="--enter-delay:120ms" set:html={renderInline(topic.lede)} />
      </div>
    </div>

    <nav aria-label={copy.topic.onThisPage} class="cert-subnav" data-pagefind-ignore>
      <div class="cert-wrap">
        <ul class="cert-subnav__list" data-subnav>
          {
            topic.sections.map((section) => (
              <li>
                <a href={`#${section.id}`} class="cert-subnav__tab" data-section-link={section.id}>
                  {section.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="cert-wrap cert-main">
      {topic.sections.map((section) => <SectionCard section={section} labels={copy.topic} />)}

      <nav class="cert-pager" aria-label={copy.nav.roadmap} data-pagefind-ignore>
        {
          previous && (
            <a href={pageHref(locale, previous.slug)} rel="prev" class="cert-pager__prev">
              <span class="cert-tile">
                <Icon name="arrow-left" size={20} />
              </span>
              <span class="cert-pager__text">
                <span class="cert-pager__label">{copy.topic.previous}</span>
                <span class="cert-pager__title">{previous.title}</span>
              </span>
            </a>
          )
        }
        {
          next && (
            <a href={pageHref(locale, next.slug)} rel="next" class="cert-pager__next">
              <span class="cert-pager__text">
                <span class="cert-pager__label">{copy.topic.next}</span>
                <span class="cert-pager__title">{next.title}</span>
              </span>
              <span class="cert-tile">
                <Icon name="arrow-right" size={20} />
              </span>
            </a>
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/reading.ts'
</script>
