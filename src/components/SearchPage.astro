---
/**
 * The search over the notes, in one language.
 *
 * The index is built by Pagefind after the site, from the text of the topic pages only, and one index is
 * kept per language, so a reader on the English page searches the English notes. The bar opens the same
 * form as a dialog over any page; this page is where its link leads when no script runs, and where a
 * search with the term in the address lands.
 */
import { pagePaths } from '../i18n'
import { getCopy, type Locale, MAIN_ID } from '../i18n/strings'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageCover from './PageCover.astro'
import SearchForm from './SearchForm.astro'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = getCopy(locale)
const labels = copy.search
---

<BaseLayout locale={locale} title={labels.title} description={labels.lede} paths={pagePaths('search')} noindex>
  <main id={MAIN_ID} class="cert-page">
    <PageCover locale={locale} icon="search" title={labels.title} lede={labels.lede} />

    <div class="cert-wrap cert-main">
      <SearchForm locale={locale} id="search-term" />
    </div>
  </main>
</BaseLayout>
