---
/**
 * The picture beside the words of the home: the cloud at the center, with the services of the roadmap
 * turning around it on two rings, in opposite directions. Each icon turns back as its ring turns, so it
 * stays upright the whole way round.
 *
 * Decorative and hidden from assistive tech, because the same roadmap is published as links right below.
 * Under reduced motion the rings stand still.
 */
import type { IconName } from './icons'
import Icon from './Icon.astro'

const inner: readonly IconName[] = ['storage', 'database', 'cpu', 'network']
const outer: readonly IconName[] = ['shield', 'chart', 'plug', 'coin', 'sparkles', 'globe']
---

<div class="ccp-orbit" aria-hidden="true">
  <svg class="ccp-orbit__rings" viewBox="0 0 400 400">
    <circle cx="200" cy="200" r="190" fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-dasharray="2 9"></circle>
    <circle cx="200" cy="200" r="118" fill="none" stroke="currentColor" stroke-opacity="0.24"></circle>
  </svg>
  <span class="ccp-orbit__glow"></span>

  <div class="ccp-orbit__ring ccp-orbit__ring--outer" style="--radius:0.475">
    {
      outer.map((icon, index) => (
        <span class="ccp-orbit__slot" style={`--angle:${(360 / outer.length) * index}deg`}>
          <span class="ccp-orbit__chip">
            <Icon name={icon} size={20} />
          </span>
        </span>
      ))
    }
  </div>
  <div class="ccp-orbit__ring ccp-orbit__ring--inner" style="--radius:0.295">
    {
      inner.map((icon, index) => (
        <span class="ccp-orbit__slot" style={`--angle:${(360 / inner.length) * index + 45}deg`}>
          <span class="ccp-orbit__chip ccp-orbit__chip--small">
            <Icon name={icon} size={18} />
          </span>
        </span>
      ))
    }
  </div>

  <span class="ccp-orbit__core">
    <Icon name="cloud" size={54} />
  </span>
</div>
