---
/**
 * The review of the notes, in one language: every section of every topic turned into a card that shows
 * the summary and hides the name. The reader tries to recall what is being described and opens the card
 * to check, which is the shape most questions of the exam take.
 *
 * Each card is a native disclosure, so the page works with no script at all. The script adds the one
 * thing a review needs on top: marking the cards the reader already knows, remembered in this browser,
 * so the next session can hide them. The study resources are left out, since a list of links is
 * nothing to recall.
 */
import { renderInline } from '../content/inline'
import { topicsOf } from '../content'
import { SITE } from '../content/site'
import { pageHref, pagePaths } from '../i18n'
import { getCopy, type Locale, MAIN_ID } from '../i18n/strings'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from './Icon.astro'
import PageCover from './PageCover.astro'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = getCopy(locale)
const labels = copy.review
const topics = topicsOf(locale).filter((topic) => topic.sections.every((section) => section.points !== undefined))
---

<BaseLayout locale={locale} title={labels.title} description={labels.lede} paths={pagePaths('review')}>
  <main id={MAIN_ID} class="cert-page">
    <PageCover locale={locale} icon="cards" title={labels.title} lede={labels.lede} />

    <nav aria-label={copy.topic.onThisPage} class="cert-subnav">
      <div class="cert-wrap">
        <ul class="cert-subnav__list" data-subnav>
          {
            topics.map((topic) => (
              <li>
                <a href={`#${topic.slug}`} class="cert-subnav__tab" data-section-link={topic.slug}>
                  {topic.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="cert-wrap cert-main">
      <div class="cert-review-bar" data-review={`${SITE.id}:known`} data-progress={labels.progress}>
        <p class="cert-review-bar__count" role="status" aria-live="polite" data-review-count></p>
        <label class="cert-review-bar__toggle">
          <input type="checkbox" data-review-hide />
          {labels.hideKnown}
        </label>
        <button type="button" class="cert-review-bar__reset" data-review-reset>{labels.reset}</button>
      </div>

      {
        topics.map((topic) => (
          <section id={topic.slug} class="cert-deck" aria-labelledby={`${topic.slug}-title`}>
            <h2 id={`${topic.slug}-title`} class="cert-deck__title">
              <span class="cert-tile">
                <Icon name={topic.icon} size={20} />
              </span>
              {topic.title}
            </h2>
            <ul class="cert-deck__cards">
              {topic.sections.map((section) => (
                <li data-card={`${topic.slug}#${section.id}`}>
                  <details class="cert-flash">
                    <summary class="cert-flash__front">
                      <span class="cert-flash__question">{labels.question}</span>
                      <span class="cert-flash__summary" set:html={renderInline(section.summary)} />
                      <span class="cert-flash__reveal">
                        {labels.reveal}
                        <Icon name="chevron" size={16} />
                      </span>
                    </summary>
                    <div class="cert-flash__back">
                      <p class="cert-flash__answer">
                        {section.name}
                        {section.fullName && <span>{section.fullName}</span>}
                      </p>
                      <p class="cert-flash__tip" set:html={renderInline(section.tip)} />
                      <div class="cert-flash__actions">
                        <button type="button" class="cert-flash__known" aria-pressed="false" data-card-known>
                          <Icon name="check" size={16} />
                          {labels.known}
                        </button>
                        <a href={`${pageHref(locale, topic.slug)}#${section.id}`} class="cert-flash__link">
                          {labels.openSection}
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/review-progress.ts'
</script>
